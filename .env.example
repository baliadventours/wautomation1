# ==============================================================================
# WhatsSaaS - Multi-Tenant WhatsApp Automation Environment Variables
# ==============================================================================

# 1. Supabase Credentials (PostgreSQL, Auth, RLS)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Evolution API (Self-Hosted on VPS via Docker)
# Internal or public URL to your Evolution API container
EVOLUTION_API_BASE_URL="http://your-vps-ip:8080"
# Global admin API key set in Evolution API docker-compose (AUTHENTICATION_API_KEY)
EVOLUTION_API_ADMIN_KEY="wac_gateway_master_key_8921a"

# 3. Application Domain & Webhook Configuration
NEXT_PUBLIC_APP_URL="https://my-saas-domain.com"
# 32-character encryption key for AES-256-GCM storage of per-instance tokens
ENCRYPTION_KEY="your-super-secret-32-character-key!"

# 4. Stripe Billing (Optional / Stubbed for MVP)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

